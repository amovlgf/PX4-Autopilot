menuconfig SYSTEMCMDS_HW_TEST
	bool "hw_test"
	default n
	depends on PLATFORM_NUTTX && !BOARD_CONSTRAINED_FLASH
	select SYSTEMCMDS_MTD
	---help---
		Enable support for hw_test

menuconfig USER_HW_TEST
	bool "hw_test running as userspace module"
	default y
	depends on BOARD_PROTECTED && SYSTEMCMDS_HW_TEST
	---help---
		Put hw_test in userspace memory
