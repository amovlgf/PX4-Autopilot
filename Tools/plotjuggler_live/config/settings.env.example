# Copy to settings.env to override defaults. This is trusted Bash configuration.
# Keep ROS_DOMAIN_ID / PJ_DDS_PORT aligned with the existing PX4 configuration.
# PX4 paths are detected relative to this tool unless explicitly overridden.
# PJ_PX4_DIR=/home/amovlgf/PX4-Autopilot
# PJ_STATE_DIR=/home/amovlgf/PX4-Autopilot/Tools/plotjuggler_live/.state
PJ_IMAGE=px4-plotjuggler-live:humble-2.4.2
PJ_DDS_PORT=8888
ROS_DOMAIN_ID=0
PJ_BUFFER_SECONDS=60
PJ_PROBE_SECONDS=10
PJ_STARTUP_SECONDS=30
# Follow the existing PX4 DDS participant without changing its parameters.
ROS_LOCALHOST_ONLY=auto
# PJ_QGC_DIR=/home/amovlgf/QGroundControl
# PJ_QGC_BIN=/home/amovlgf/QGroundControl/build/Debug/QGroundControl
# PJ_QGC_RUNNER=/home/amovlgf/QGroundControl/tools/run-qgroundcontrol.sh
# Optional validated layout path inside the container.
# PJ_LAYOUT=/opt/px4-monitor/layouts/live.xml
