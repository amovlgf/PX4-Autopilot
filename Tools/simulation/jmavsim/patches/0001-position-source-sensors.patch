+    private void sendPositionObservations(PositionSourceSensors sensors) {
+        PositionSourceSensors.RangeReport range = sensors.takeRange();
+        if (range != null) {
+            MAVLinkMessage message = new MAVLinkMessage(schema, "DISTANCE_SENSOR", sysId, componentId, protocolVersion);
+            boolean valid = Double.isFinite(range.distance);
+            message.set("time_boot_ms", range.time);
+            message.set("min_distance", (int)Math.round(sensors.rangeMinimum * 100));
+            message.set("max_distance", (int)Math.round(sensors.rangeMaximum * 100));
+            // Above maximum denotes an unavailable measurement; quality also explicitly rejects it.
+            message.set("current_distance", valid ? (int)Math.round(range.distance * 100)
+                        : (int)Math.round(sensors.rangeMaximum * 100) + 1);
+            message.set("type", 0); // MAV_DISTANCE_SENSOR_LASER.
+            message.set("id", 0);
+            message.set("orientation", 25); // MAV_SENSOR_ROTATION_PITCH_270: body down.
+            message.set("covariance", Math.min(254, (int)Math.round(sensors.rangeStd * sensors.rangeStd * 10000)));
+            message.set("signal_quality", valid ? 100 : 1); // MAVLink 1 is invalid, 100 is best.
+            sendMessage(message);
+        }
+
+        PositionSourceSensors.VisionReport vision = sensors.takeVision();
+        if (vision != null) {
+            MAVLinkMessage message = new MAVLinkMessage(schema, "ODOMETRY", sysId, componentId, protocolVersion);
+            message.set("time_usec", vision.time * 1000);
+            message.set("frame_id", 1); // MAV_FRAME_LOCAL_NED.
+            message.set("child_frame_id", 1); // Linear and angular velocities expressed in NED.
+            message.set("x", vision.position.x);
+            message.set("y", vision.position.y);
+            message.set("z", vision.position.z);
+            message.set("q", vision.quaternion);
+            message.set("vx", vision.velocity.x);
+            message.set("vy", vision.velocity.y);
+            message.set("vz", vision.velocity.z);
+            message.set("rollspeed", vision.angularVelocity.x);
+            message.set("pitchspeed", vision.angularVelocity.y);
+            message.set("yawspeed", vision.angularVelocity.z);
+            message.set("pose_covariance", vision.poseCovariance);
+            message.set("velocity_covariance", vision.velocityCovariance);
+            message.set("reset_counter", 0);
+            message.set("estimator_type", 2); // MAV_ESTIMATOR_TYPE_VISION.
+            message.set("quality", 100);
+            sendMessage(message);
+        }
+    }
+
