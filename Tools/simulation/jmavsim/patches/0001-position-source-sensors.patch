new file mode 100644
index 0000000..0bb05f5
--- /dev/null
+++ b/src/me/drton/jmavsim/SensorModel.java
@@ -0,0 +1,133 @@
+package me.drton.jmavsim;
+
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.util.ArrayDeque;
+import java.util.Properties;
+import java.util.Random;
+import javax.vecmath.Matrix3d;
+import javax.vecmath.Quat4d;
+import javax.vecmath.Vector3d;
+
+/** Shared measurement geometry, deterministic noise and simulation-time delays. */
+public final class SensorModel {
+    private SensorModel() {
+    }
+
+    public static final class Config {
+        private final Properties values = new Properties();
+
+        public Config() {
+            String filename = System.getProperty("jmavsim.sensorConfig");
+            if (filename != null) {
+                try (FileInputStream stream = new FileInputStream(filename)) {
+                    values.load(stream);
+                } catch (IOException e) {
+                    throw new IllegalArgumentException("Cannot read sensor configuration " + filename, e);
+                }
+            }
+        }
+
+        public double number(String name, double fallback, double minimum, double maximum) {
+            double value = Double.parseDouble(values.getProperty(name, Double.toString(fallback)));
+            if (!Double.isFinite(value) || value < minimum || value > maximum) {
+                throw new IllegalArgumentException(name + " must be between " + minimum + " and " + maximum);
+            }
+            return value;
+        }
+
+        public long seed(String name, long fallback) {
+            return Long.parseLong(values.getProperty(name, Long.toString(fallback)));
+        }
+
+        public double period(String name, double fallback) {
+            return 1000.0 / number(name, fallback, 1.0, 250.0);
+        }
+    }
+
+    public static final class Timed<T> {
+        public final long time;
+        public final T value;
+        public Timed(long time, T value) {
+            this.time = time;
+            this.value = value;
+        }
+    }
+
+    /** Returns each delayed sample exactly once, including while the producer is between samples. */
+    public static final class Delay<T> {
+        private final ArrayDeque<Timed<T>> queue = new ArrayDeque<Timed<T>>();
+        private final double delayMs;
+        public Delay(double delayMs) {
+            this.delayMs = delayMs;
+        }
+        public void add(long time, T value) {
+            queue.addLast(new Timed<T>(time, value));
+        }
+        public T poll(long time) {
+            if (!queue.isEmpty() && time - queue.peekFirst().time >= delayMs) {
+                return queue.removeFirst().value;
+            }
+            return null;
+        }
+    }
+
+    /** Correlated receiver error with bounded uniform innovations, stationary variance stddev^2. */
+    public static double correlatedError(double previous, double stddev, double dt,
+                                         double correlationTime, Random random) {
+        double decay = Math.exp(-dt / correlationTime);
+        return decay * previous + stddev * Math.sqrt(3.0 * (1.0 - decay * decay))
+               * (2.0 * random.nextDouble() - 1.0);
+    }
+
+    public static Vector3d noise(Vector3d value, double stddev, Random random) {
+        return new Vector3d(value.x + stddev * random.nextGaussian(),
+                            value.y + stddev * random.nextGaussian(),
+                            value.z + stddev * random.nextGaussian());
+    }
+
+    /** MAVLink HIL_GPS yaw uses zero for invalid and 36000 for due north. */
+    public static int headingCentidegrees(Matrix3d bodyToNed, double baseline,
+                                          double minimumHorizontal, double noiseRadians) {
+        double north = baseline * bodyToNed.m00;
+        double east = baseline * bodyToNed.m10;
+        if (Math.hypot(north, east) < minimumHorizontal) {
+            return 0;
+        }
+        double degrees = (Math.toDegrees(Math.atan2(east, north) + noiseRadians) % 360.0 + 360.0) % 360.0;
+        int centidegrees = (int)Math.round(degrees * 100.0);
+        return centidegrees == 0 ? 36000 : centidegrees;
+    }
+
+    /** Range from the body origin along +body Z to the horizontal ground plane, NED coordinates. */
+    public static double groundRange(double downPosition, double groundDown, Matrix3d bodyToNed,
+                                      double minimum, double maximum, double noiseMeters) {
+        if (bodyToNed.m22 <= 0.0) {
+            return Double.NaN;
+        }
+        double distance = (groundDown - downPosition) / bodyToNed.m22;
+        if (distance < minimum || distance > maximum) {
+            return Double.NaN;
+        }
+        return Math.max(minimum, Math.min(maximum, distance + noiseMeters));
+    }
+
+    /** Unit quaternion in MAVLink [w,x,y,z] order, rotation body FRD to local NED. */
+    public static Float[] quaternion(Matrix3d bodyToNed) {
+        Quat4d quaternion = new Quat4d();
+        quaternion.set(bodyToNed);
+        quaternion.normalize();
+        return new Float[] {(float)quaternion.w, (float)quaternion.x, (float)quaternion.y, (float)quaternion.z};
+    }
+
+    public static Float[] covariance(double linearStd, double angularStd) {
+        Float[] covariance = new Float[21];
+        java.util.Arrays.fill(covariance, 0.0f);
+        int[] diagonal = {0, 6, 11, 15, 18, 20};
+        for (int index = 0; index < diagonal.length; ++index) {
+            double std = index < 3 ? linearStd : angularStd;
+            covariance[diagonal[index]] = (float)(std * std);
+        }
+        return covariance;
+    }
+}
