diff --git a/src/me/drton/jmavsim/PositionSourceSensors.java b/src/me/drton/jmavsim/PositionSourceSensors.java
new file mode 100644
index 0000000..f2679e1
--- /dev/null
+++ b/src/me/drton/jmavsim/PositionSourceSensors.java
@@ -0,0 +1,269 @@
+package me.drton.jmavsim;
+
+import java.util.Random;
+import javax.vecmath.AxisAngle4d;
+import javax.vecmath.Matrix3d;
+import javax.vecmath.Vector3d;
+import me.drton.jmavlib.geo.GlobalPositionProjector;
+import me.drton.jmavlib.geo.LatLonAlt;
+
+/** Two independent IMUs and truth-derived RTK, heading, range and visual odometry measurements. */
+public class PositionSourceSensors extends SimpleSensors {
+    private final SensorModel.Config config = new SensorModel.Config();
+    private final Random[] imuRandom = {
+        new Random(config.seed("imu1.seed", 1001)), new Random(config.seed("imu2.seed", 1002))
+    };
+    private final Random magRandom = new Random(config.seed("mag.seed", 2001));
+    private final Random baroRandom = new Random(config.seed("baro.seed", 2002));
+    private final Random gnssRandom = new Random(config.seed("gnss.seed", 3001));
+    private final Random headingRandom = new Random(config.seed("heading.seed", 3002));
+    private final Random rangeRandom = new Random(config.seed("range.seed", 4001));
+    private final Random visionRandom = new Random(config.seed("vision.seed", 5001));
+    private final double accelerationStd = config.number("imu.acceleration_std_m_s2", 0.05, 0.0, 10.0);
+    private final double angularRateStd = config.number("imu.angular_rate_std_rad_s", 0.01, 0.0, 1.0);
+    private final double magneticStd = config.number("mag.std_gauss", 0.005, 0.0, 1.0);
+    private final double pressureAltitudeStd = config.number("baro.altitude_std_m", 0.1, 0.0, 100.0);
+    private final double gnssPeriod = config.period("gnss.rate_hz", 20);
+    private final double gnssHorizontalStd = config.number("gnss.horizontal_std_m", 0.02, 0.01, 100.0);
+    private final double gnssVerticalStd = config.number("gnss.vertical_std_m", 0.03, 0.01, 100.0);
+    private final double gnssVelocityStd = config.number("gnss.velocity_std_m_s", 0.05, 0.001, 10.0);
+    private final double gnssCorrelation = config.number("gnss.correlation_time_s", 10, 0.1, 3600);
+    private final double headingBaseline = config.number("heading.baseline_m", 0.5, 0.01, 10);
+    private final double headingMinimumHorizontal = config.number("heading.minimum_horizontal_m", 0.05, 0.001, 10);
+    private final double headingStd = Math.toRadians(config.number("heading.std_deg", 0.5, 0.01, 45));
+    private final double rangePeriod = config.period("range.rate_hz", 20);
+    public final double rangeMinimum = config.number("range.minimum_m", 0.1, 0.01, 600);
+    public final double rangeMaximum = config.number("range.maximum_m", 30, rangeMinimum, 650);
+    public final double rangeStd = config.number("range.std_m", 0.02, 0, 10);
+    private final double visionPeriod = config.period("vision.rate_hz", 25);
+    private final double visionPositionStd = config.number("vision.position_std_m", 0.05, 0.001, 100);
+    private final double visionVelocityStd = config.number("vision.velocity_std_m_s", 0.05, 0.001, 10);
+    private final double visionAttitudeStd = Math.toRadians(config.number("vision.attitude_std_deg", 0.5, 0.001, 90));
+    private final double visionAngularRateStd = config.number("vision.angular_rate_std_rad_s", 0.01, 0.001, 1);
+    private final Vector3d visionDriftRate = new Vector3d(
+        config.number("vision.drift_north_m_s", 0, -10, 10),
+        config.number("vision.drift_east_m_s", 0, -10, 10),
+        config.number("vision.drift_down_m_s", 0, -10, 10));
+    private final SensorModel.Delay<GNSSReport> gnssDelay = new SensorModel.Delay<GNSSReport>(
+        config.number("gnss.delay_ms", 200, 0, 300));
+    private final SensorModel.Delay<VisionReport> visionDelay = new SensorModel.Delay<VisionReport>(
+        config.number("vision.delay_ms", 40, 0, 300));
+    private final GlobalPositionProjector projector = new GlobalPositionProjector();
+    private final Vector3d gnssPositionError = new Vector3d();
+    private final Vector3d gnssVelocityError = new Vector3d();
+    private DynamicObject body;
+    private GNSSReport gnss;
+    private boolean gnssUpdated;
+    private RangeReport range;
+    private VisionReport vision;
+    private double nextGnss;
+    private double nextRange;
+    private double nextVision;
+    private long lastGnss = -1;
+    private long startTime;
+    private double pressureAltitude;
+    private LatLonAlt trueGlobalPosition;
+
+    public PositionSourceSensors() {
+        // The lockstep physics scheduler and IMU outputs must use the same frequency.
+        config.number("imu.rate_hz", 250, 250, 250);
+    }
+
+    @Override
+    public void setObject(DynamicObject object, long time) {
+        super.setObject(object, time);
+        body = object;
+        projector.init(object.getWorld().getGlobalReference());
+        startTime = time;
+        nextGnss = nextRange = nextVision = time;
+        updateTruePosition();
+    }
+
+    private void updateTruePosition() {
+        Vector3d position = body.getPosition();
+        trueGlobalPosition = projector.reproject(new double[] {position.x, position.y, position.z});
+    }
+
+    @Override
+    public LatLonAlt getGlobalPosition() {
+        return trueGlobalPosition;
+    }
+
+    @Override
+    public Vector3d getAcc() {
+        return getAcc(0);
+    }
+
+    public Vector3d getAcc(int index) {
+        Vector3d acceleration = new Vector3d(body.getAcceleration());
+        acceleration.sub(body.getWorld().getEnvironment().getG());
+        Matrix3d nedToBody = new Matrix3d(body.getRotation());
+        nedToBody.transpose();
+        nedToBody.transform(acceleration);
+        return SensorModel.noise(acceleration, accelerationStd, imuRandom[index]);
+    }
+
+    @Override
+    public Vector3d getGyro() {
+        return getGyro(0);
+    }
+
+    public Vector3d getGyro(int index) {
+        return SensorModel.noise(body.getRotationRate(), angularRateStd, imuRandom[index]);
+    }
+
+    @Override
+    public Vector3d getMag() {
+        Vector3d magnetic = new Vector3d(body.getWorld().getEnvironment().getMagField(body.getPosition()));
+        Matrix3d nedToBody = new Matrix3d(body.getRotation());
+        nedToBody.transpose();
+        nedToBody.transform(magnetic);
+        magnetic.scale(getMagScale());
+        return SensorModel.noise(magnetic, magneticStd, magRandom);
+    }
+
+    @Override
+    public double getPressureAlt() {
+        return pressureAltitude;
+    }
+
+    @Override
+    public double getPressure() {
+        // Pressure and pressure altitude are one measurement, not two independent noise draws.
+        return SimpleEnvironment.alt2baro(pressureAltitude);
+    }
+
+    @Override
+    public GNSSReport getGNSS() {
+        return gnss;
+    }
+
+    @Override
+    public boolean isGPSUpdated() {
+        boolean updated = gnssUpdated;
+        gnssUpdated = false;
+        return updated;
+    }
+
+    public RangeReport takeRange() {
+        RangeReport result = range;
+        range = null;
+        return result;
+    }
+
+    public VisionReport takeVision() {
+        VisionReport result = vision;
+        vision = null;
+        return result;
+    }
+
+    @Override
+    public void update(long time, boolean paused) {
+        if (paused) {
+            return;
+        }
+        updateTruePosition();
+        pressureAltitude = trueGlobalPosition.alt + pressureAltitudeStd * baroRandom.nextGaussian();
+
+        if (getGPSStartTime() >= 0 && time >= getGPSStartTime() && time >= nextGnss) {
+            if (lastGnss < 0) {
+                nextGnss = time;
+            }
+            nextGnss += gnssPeriod;
+            GNSSReport report = sampleGnss(time);
+            gnssDelay.add(time, report);
+        }
+        GNSSReport delayedGnss = gnssDelay.poll(time);
+        if (delayedGnss != null) {
+            gnss = delayedGnss;
+            gnssUpdated = true;
+        }
+
+        if (time >= nextRange) {
+            nextRange += rangePeriod;
+            double distance = SensorModel.groundRange(body.getPosition().z,
+                body.getWorld().getEnvironment().getGroundLevelAt(body.getPosition()), body.getRotation(),
+                rangeMinimum, rangeMaximum, rangeStd * rangeRandom.nextGaussian());
+            range = new RangeReport(time, distance);
+        }
+
+        if (time >= nextVision) {
+            nextVision += visionPeriod;
+            visionDelay.add(time, sampleVision(time));
+        }
+        VisionReport delayedVision = visionDelay.poll(time);
+        if (delayedVision != null) {
+            vision = delayedVision;
+        }
+    }
+
+    private GNSSReport sampleGnss(long time) {
+        double dt = lastGnss < 0 ? gnssPeriod * 0.001 : (time - lastGnss) * 0.001;
+        lastGnss = time;
+        gnssPositionError.x = SensorModel.correlatedError(gnssPositionError.x, gnssHorizontalStd, dt, gnssCorrelation, gnssRandom);
+        gnssPositionError.y = SensorModel.correlatedError(gnssPositionError.y, gnssHorizontalStd, dt, gnssCorrelation, gnssRandom);
+        gnssPositionError.z = SensorModel.correlatedError(gnssPositionError.z, gnssVerticalStd, dt, gnssCorrelation, gnssRandom);
+        gnssVelocityError.x = SensorModel.correlatedError(gnssVelocityError.x, gnssVelocityStd, dt, gnssCorrelation, gnssRandom);
+        gnssVelocityError.y = SensorModel.correlatedError(gnssVelocityError.y, gnssVelocityStd, dt, gnssCorrelation, gnssRandom);
+        gnssVelocityError.z = SensorModel.correlatedError(gnssVelocityError.z, gnssVelocityStd, dt, gnssCorrelation, gnssRandom);
+        Vector3d position = new Vector3d(body.getPosition());
+        position.add(gnssPositionError);
+        GNSSReport report = new GNSSReport();
+        report.position = projector.reproject(new double[] {position.x, position.y, position.z});
+        report.velocity = new Vector3d(body.getVelocity());
+        report.velocity.add(gnssVelocityError);
+        report.eph = (float)gnssHorizontalStd;
+        report.epv = (float)gnssVerticalStd;
+        report.fix = 6; // MAVLink GPS_FIX_TYPE_RTK_FIXED.
+        report.time = time * 1000;
+        report.heading = SensorModel.headingCentidegrees(body.getRotation(), headingBaseline,
+            headingMinimumHorizontal, headingStd * headingRandom.nextGaussian());
+        return report;
+    }
+
+    private VisionReport sampleVision(long time) {
+        VisionReport report = new VisionReport();
+        report.time = time;
+        report.position = SensorModel.noise(body.getPosition(), visionPositionStd, visionRandom);
+        Vector3d drift = new Vector3d(visionDriftRate);
+        drift.scale((time - startTime) * 0.001);
+        report.position.add(drift);
+        report.velocity = SensorModel.noise(body.getVelocity(), visionVelocityStd, visionRandom);
+        report.velocity.add(visionDriftRate);
+        Matrix3d rotation = new Matrix3d(body.getRotation());
+        Vector3d angleError = SensorModel.noise(new Vector3d(), visionAttitudeStd, visionRandom);
+        Matrix3d errorRotation = new Matrix3d();
+        double errorAngle = angleError.length();
+        if (errorAngle > 0.0) {
+            angleError.scale(1.0 / errorAngle);
+            errorRotation.set(new AxisAngle4d(angleError, errorAngle));
+            rotation.mul(errorRotation);
+        }
+        report.quaternion = SensorModel.quaternion(rotation);
+        // child_frame_id is LOCAL_NED: angular velocity uses that frame too.
+        report.angularVelocity = SensorModel.noise(body.getRotationRate(), visionAngularRateStd, visionRandom);
+        body.getRotation().transform(report.angularVelocity);
+        report.poseCovariance = SensorModel.covariance(visionPositionStd, visionAttitudeStd);
+        report.velocityCovariance = SensorModel.covariance(visionVelocityStd, visionAngularRateStd);
+        return report;
+    }
+
+    public static final class RangeReport {
+        public final long time;
+        public final double distance;
+        RangeReport(long time, double distance) {
+            this.time = time;
+            this.distance = distance;
+        }
+    }
+
+    public static final class VisionReport {
+        public long time;
+        public Vector3d position;
+        public Vector3d velocity;
+        public Float[] quaternion;
+        public Vector3d angularVelocity;
+        public Float[] poseCovariance;
+        public Float[] velocityCovariance;
+    }
+}
